# deploy.env — SSH target for deploy.sh. Copy to deploy.env and fill in.
# deploy.env is gitignored: your production coordinates stay off GitHub.
SSH_USER="youruser"
SSH_HOST="server.example.com"
SSH_PORT="22"
REMOTE_DIR="/home/youruser/domains/example.com/public_html"

# Optional. deploy.sh re-runs tools/geoip_update.php when content/geoip.dat is
# older than this, so the deploy never pushes a stale IP->country database over
# a fresher one on the server. DB-IP publishes monthly; 7 days picks up a new
# release quickly without re-downloading on every deploy. 0 = refresh always.
GEOIP_MAX_AGE_DAYS="7"

# Optional. ./deploy.sh --pull-logs downloads the site's own runtime data
# (analytics.db, newsletter.db, scores.db, comments, content/*.log). Point this
# at the host's web-server log directory to pull its access/error logs too —
# on MyDevil that is ~/domains/<domain>/logs. Leave it unset to skip that step.
# REMOTE_LOG_DIR="/home/youruser/domains/example.com/logs"
