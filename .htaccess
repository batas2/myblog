# bfrackowiak.pl — Apache configuration
# Charset, compression, caching, security headers, and access control.

AddDefaultCharset UTF-8
Options -Indexes

# ---- canonical host: force HTTPS and strip www (one URL per page for
# search engines; HSTS only protects after the first secure visit) ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # retired URLs Search Console still crawls (seen 2026-10): /index.html, and the
  # one 2021 blog post that lives on as an essay. THE_REQUEST so a DirectoryIndex
  # lookup of index.html never bounces. The other two 2021 posts have no
  # successor and stay 404 on purpose — a redirect to the home page is a soft 404.
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/index\.html[\s?]
  RewriteRule ^index\.html$ https://%{HTTP_HOST}/ [R=301,L]
  RewriteRule ^2021/06/21/branches-and-code-merging-at-scale-automated-branch-merging/?$ https://%{HTTP_HOST}/blog/the-automerger/ [R=301,L]
</IfModule>

# branded 404 (generated by tools/build.php) — dead links become entrances
ErrorDocument 404 /404.php

# ---- access control: nothing internal is ever served -------------------------
# private/internal directories → 404 (not 403, no information leak)
RedirectMatch 404 ^/(lib|tools|tests|docs|drafts|content|vendor|_archive|_remote-backup|\.git)(/|$)

# sensitive root files → 404
# deploy.env(.example), Dockerfile, docker-compose.yml and run.sh added 2026-10-11:
# the access log showed /deploy.env answering 200 (it carries the SSH target).
<FilesMatch "^(config\.php|config\.example\.php|deploy\.sh|deploy\.env|deploy\.env\.example|Dockerfile|docker-compose\.yml|run\.sh|\.gitignore|\.htaccess)$">
  Require all denied
</FilesMatch>

# dotfiles in general
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# ---- security headers ---------------------------------------------------------
# Sent from PHP, not from here: SECURITY_HEADERS in lib/page.php. On the live host
# (nginx in front of Apache) Header lines in this file never reached a response.

# ---- compression ----------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/markdown application/javascript application/json application/rss+xml application/xml image/svg+xml
</IfModule>

# ---- browser caching --------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType image/vnd.microsoft.icon "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType application/rss+xml "access plus 1 hour"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
</IfModule>

# correct MIME for markdown mirrors (AI agents fetch these)
AddType text/markdown .md

# the film. Byte-range requests are what let a browser start playing before the
# whole file has arrived, so keep them enabled explicitly.
AddType video/mp4 .mp4
AddType video/webm .webm
<IfModule mod_headers.c>
  <FilesMatch "\.(mp4|webm)$">
    Header set Accept-Ranges bytes
  </FilesMatch>
</IfModule>
