# secrets — copy config.example.php to config.php and fill in
/config.php

# generated output (php tools/build.php recreates all of it)
blog/
feed.xml
sitemap.xml
llms-full.txt
/404.php

# runtime data written by the live site
content/analytics.db
content/geoip.dat
content/analytics.db-*
content/analytics.seed
content/newsletter.db
content/newsletter.db-*
# generated mirror of the scores held in content/posts/*.md (tools/build.php)
content/scores.db
content/scores.db-*
content/.ratelimit/
content/comments/*.json

# remote backups pulled by deploy.sh
_remote-backup/

# private notes and old files
docs/
_archive/
Refernce/

# local noise
.DS_Store
*.log
.claude/
content/newsletter.lock
content/.sessions/
content/.buildlock

# never publish: unpublished essays and working drafts.
# Exception: drafts/diagrams/ holds the .drawio sources behind the PNGs in
# assets/img/posts/ — an export you cannot edit is a dead end, so the sources
# are versioned. deploy.sh still excludes drafts/ entirely, so nothing is served.
drafts/*
!drafts/diagrams/

# deployment target (per-machine, holds the SSH coordinates)
deploy.env
