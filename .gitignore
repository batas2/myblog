# generated output (php tools/build.php recreates all of it)
blog/
feed.xml
sitemap.xml
llms-full.txt
/404.php

# runtime data written by the live site
content/analytics.db
content/geoip.dat
content/analytics.db-*
content/analytics.seed
content/newsletter.db
content/newsletter.db-*
# generated mirror of the scores held in content/posts/*.md (tools/build.php)
content/scores.db
content/scores.db-*
content/.ratelimit/
content/comments/*.json

# remote backups pulled by deploy.sh
_remote-backup/
# runtime data pulled by deploy.sh --pull-logs (analytics, subscribers, comments)
_remote-logs/

# local noise
.DS_Store
*.log
.claude/
content/newsletter.lock
content/.sessions/
content/.buildlock

# render intermediates: the .drawio beside them is the editable source
drafts/diagrams/**/*.svg

# briefs that tools/review_export.php writes from content/review/
drafts/review/

# deploy bookkeeping
content/.sync-state
/build.txt
