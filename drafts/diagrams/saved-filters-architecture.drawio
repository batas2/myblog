        <mxCell id="n2" value="&lt;b&gt;2. resolve user id from authenticated context&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#F5A623;fontColor=#7F5A00;fontSize=11;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="340" y="230" width="320" height="40" as="geometry"/></mxCell>
