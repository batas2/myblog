        <mxCell id="bad" value="&lt;b&gt;Rejected: user id in the request body. The client could write into anyone&#x27;s collection.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7A1F1A;fontSize=11;align=left;verticalAlign=middle;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="660" height="60" as="geometry"/></mxCell>
        <mxCell id="good" value="&lt;b&gt;Chosen: user id from the auth context. Isolation becomes a property of the design.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1B3A1B;fontSize=11;align=left;verticalAlign=middle;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="600" width="640" height="60" as="geometry"/></mxCell>
