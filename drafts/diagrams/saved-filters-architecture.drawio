      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="banner" value="&lt;b&gt;Feature vs service. What a new service would have to own&lt;/b&gt;&lt;br&gt;Earn a service only when it owns its data, its lifecycle, and an independent failure domain." style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#12203F;fontColor=#FFFFFF;fontSize=17;align=left;verticalAlign=middle;spacing=8;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1280" height="58" as="geometry"/></mxCell>
