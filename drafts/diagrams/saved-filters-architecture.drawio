        <mxCell id="banner" value="&lt;b&gt;Identity from context. Whose filter is this&lt;/b&gt;&lt;br&gt;The user id is never a field the client sends. It is a fact the platform already holds." style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#12203F;fontColor=#FFFFFF;fontSize=17;align=left;verticalAlign=middle;spacing=8;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1360" height="58" as="geometry"/></mxCell>
