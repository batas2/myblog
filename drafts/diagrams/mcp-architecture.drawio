<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram id="d0" name="Container. AI connector">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="760" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="banner" value="&lt;b&gt;AI connector architecture. A read-only proxy that reuses the existing trust&lt;/b&gt;&lt;br&gt;AI tools query an existing API in natural language. No new grant, no broker, no key store." style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#12203F;fontColor=#FFFFFF;fontSize=17;align=left;verticalAlign=middle;spacing=8;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1440" height="58" as="geometry"/></mxCell>
        <mxCell id="ai" value="&lt;b&gt;AI tool / agent&lt;/b&gt;&lt;br&gt;&lt;i&gt;(MCP client)&lt;/i&gt;&lt;br&gt;Claude, Copilot,&lt;br&gt;custom agents" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#7A3E00;fontSize=13;align=left;verticalAlign=top;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="210" height="120" as="geometry"/></mxCell>
        <mxCell id="opt" value="&lt;b&gt;Auth options considered&lt;/b&gt;&lt;br&gt;1) Machine login (chosen):&lt;br&gt;    reuse existing credential&lt;br&gt;    exchange, no new secret&lt;br&gt;2) Issued key / PAT broker&lt;br&gt;3) Browser OAuth + PKCE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#F5A623;fontColor=#7F5A00;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="230" height="180" as="geometry"/></mxCell>
        <mxCell id="edge" value="Shared edge (reused)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#808080;dashed=1;dashPattern=8 4;strokeWidth=2;verticalAlign=top;align=left;fontColor=#808080;fontSize=12;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="240" height="300" as="geometry"/></mxCell>
        <mxCell id="waf" value="&lt;b&gt;Front Door + WAF&lt;/b&gt;&lt;br&gt;&lt;i&gt;TLS, OWASP&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#808080;fontColor=#333333;fontSize=13;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="322" y="162" width="196" height="88" as="geometry"/></mxCell>
        <mxCell id="gw" value="&lt;b&gt;API gateway&lt;/b&gt;&lt;br&gt;&lt;i&gt;rate limit, quotas&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#808080;fontColor=#333333;fontSize=13;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="322" y="288" width="196" height="88" as="geometry"/></mxCell>
        <mxCell id="mcp" value="MCP server (new): stateless, read-only proxy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82B366;dashed=1;dashPattern=8 4;strokeWidth=2;verticalAlign=top;align=left;fontColor=#82B366;fontSize=12;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="590" y="110" width="440" height="560" as="geometry"/></mxCell>
        <mxCell id="pipe" value="&lt;b&gt;Request pipeline&lt;/b&gt;&lt;br&gt;rate limit, credential check,&lt;br&gt;HSTS, audit, path allowlist" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6EEFC;strokeColor=#6C8EBF;fontColor=#0B2A63;fontSize=13;align=left;verticalAlign=top;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="612" y="158" width="396" height="86" as="geometry"/></mxCell>
        <mxCell id="tools" value="&lt;b&gt;Tools (read-only)&lt;/b&gt;&lt;br&gt;map language to&lt;br&gt;existing API calls" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6EEFC;strokeColor=#6C8EBF;fontColor=#0B2A63;fontSize=13;align=left;verticalAlign=top;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="612" y="262" width="186" height="92" as="geometry"/></mxCell>
        <mxCell id="tokex" value="&lt;b&gt;Token exchange&lt;/b&gt;&lt;br&gt;borrow identity&lt;br&gt;server-side" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6EEFC;strokeColor=#6C8EBF;fontColor=#0B2A63;fontSize=13;align=left;verticalAlign=top;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="818" y="262" width="190" height="92" as="geometry"/></mxCell>
        <mxCell id="cache" value="&lt;b&gt;Token cache&lt;/b&gt;&lt;br&gt;key: id + hash(secret)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#4B286D;fontSize=13;align=left;verticalAlign=top;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="818" y="372" width="190" height="66" as="geometry"/></mxCell>
        <mxCell id="mnote" value="&lt;b&gt;No new grant, broker, or key store. The secret never enters the model context.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#F5A623;fontColor=#7F5A00;fontSize=11;align=left;verticalAlign=middle;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="612" y="458" width="396" height="74" as="geometry"/></mxCell>
        <mxCell id="scale" value="&lt;b&gt;Hard part lives here: long-lived streams + shared cache at scale&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7A1F1A;fontSize=11;align=left;verticalAlign=middle;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="612" y="552" width="396" height="44" as="geometry"/></mxCell>
        <mxCell id="plat" value="Existing platform (reused)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#808080;dashed=1;dashPattern=8 4;strokeWidth=2;verticalAlign=top;align=left;fontColor=#808080;fontSize=12;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1070" y="120" width="390" height="470" as="geometry"/></mxCell>
        <mxCell id="idp" value="&lt;b&gt;Identity provider&lt;/b&gt;&lt;br&gt;&lt;i&gt;(OAuth2)&lt;/i&gt;&lt;br&gt;existing token endpoint,&lt;br&gt;client_credentials grant" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#808080;fontColor=#333333;fontSize=13;align=left;verticalAlign=top;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1092" y="162" width="346" height="96" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;Enterprise API&lt;/b&gt;&lt;br&gt;&lt;i&gt;(existing)&lt;/i&gt;&lt;br&gt;the API we wrap" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#808080;fontColor=#333333;fontSize=13;align=left;verticalAlign=top;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1092" y="282" width="346" height="92" as="geometry"/></mxCell>
        <mxCell id="data" value="&lt;b&gt;Data store&lt;/b&gt;&lt;br&gt;behind the API" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#4B286D;fontSize=13;align=left;verticalAlign=top;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1092" y="398" width="346" height="74" as="geometry"/></mxCell>
        <mxCell id="trust" value="&lt;b&gt;Same trust boundary as calling the API directly.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#F5A623;fontColor=#7F5A00;fontSize=11;align=left;verticalAlign=middle;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1092" y="500" width="346" height="74" as="geometry"/></mxCell>
        <mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;startArrow=none;strokeColor=#3A3A3A;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ai" target="waf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="286" y="210"/><mxPoint x="286" y="206"/></Array></mxGeometry></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;startArrow=none;strokeColor=#3A3A3A;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="waf" target="gw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="269"/></Array></mxGeometry></mxCell>
        <mxCell id="e3" value="/mcp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;startArrow=none;strokeColor=#3A3A3A;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="gw" target="pipe"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="565" y="332"/><mxPoint x="565" y="201"/></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;startArrow=none;strokeColor=#3A3A3A;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pipe" target="tools"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="253"/><mxPoint x="705" y="253"/></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;startArrow=none;strokeColor=#3A3A3A;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="tools" target="tokex"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="808" y="308"/></Array></mxGeometry></mxCell>
        <mxCell id="e6" value="lookup / store" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;startArrow=none;dashed=1;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="tokex" target="cache"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="913" y="363"/></Array></mxGeometry></mxCell>
        <mxCell id="e7" value="client_credentials" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;startArrow=none;dashed=1;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="tokex" target="idp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="308"/><mxPoint x="1050" y="210"/></Array></mxGeometry></mxCell>
        <mxCell id="e8" value="REST + Bearer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;startArrow=none;strokeColor=#3A3A3A;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="tools" target="api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="945" y="308"/><mxPoint x="945" y="328"/></Array></mxGeometry></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;startArrow=none;strokeColor=#3A3A3A;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="api" target="data"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1265" y="386"/></Array></mxGeometry></mxCell>
      </root></mxGraphModel>
  </diagram>
  <diagram id="d1" name="Token lifecycle">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="760" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="banner" value="&lt;b&gt;Token lifecycle. Who holds the token now&lt;/b&gt;&lt;br&gt;The client already sends these credentials to the API. The proxy borrows the identity server-side." style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#12203F;fontColor=#FFFFFF;fontSize=17;align=left;verticalAlign=middle;spacing=8;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1440" height="58" as="geometry"/></mxCell>
        <mxCell id="h_ai" value="&lt;b&gt;AI tool&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#7A3E00;fontSize=12;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="45" y="90" width="210" height="54" as="geometry"/></mxCell>
        <mxCell id="h_mcp" value="&lt;b&gt;MCP server&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1B3A1B;fontSize=12;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="365" y="90" width="210" height="54" as="geometry"/></mxCell>
        <mxCell id="h_cache" value="&lt;b&gt;Token cache&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#4B286D;fontSize=12;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="655" y="90" width="210" height="54" as="geometry"/></mxCell>
        <mxCell id="h_idp" value="&lt;b&gt;Identity provider&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#808080;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="945" y="90" width="210" height="54" as="geometry"/></mxCell>
        <mxCell id="h_api" value="&lt;b&gt;Enterprise API&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#808080;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1235" y="90" width="210" height="54" as="geometry"/></mxCell>
        <mxCell id="n" value="&lt;b&gt;The connector adds no new secret. It caches only a short-lived token, keyed by a hash of the secret, and the telemetry layer redacts the credential so it never reaches the model.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#F5A623;fontColor=#7F5A00;fontSize=11;align=left;verticalAlign=middle;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1400" height="54" as="geometry"/></mxCell>
        <mxCell id="ll_ai" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=none;startArrow=none;dashed=1;strokeColor=#9AA0A6;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="150" as="sourcePoint"/><mxPoint x="150" y="664" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll_mcp" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=none;startArrow=none;dashed=1;strokeColor=#9AA0A6;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="150" as="sourcePoint"/><mxPoint x="470" y="664" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll_cache" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=none;startArrow=none;dashed=1;strokeColor=#9AA0A6;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="150" as="sourcePoint"/><mxPoint x="760" y="664" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll_idp" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=none;startArrow=none;dashed=1;strokeColor=#9AA0A6;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1050" y="150" as="sourcePoint"/><mxPoint x="1050" y="664" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll_api" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=none;startArrow=none;dashed=1;strokeColor=#9AA0A6;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="150" as="sourcePoint"/><mxPoint x="1340" y="664" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m1" value="1. MCP request + client credentials (via edge, HTTPS)" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;startArrow=none;strokeColor=#3A3A3A;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="190" as="sourcePoint"/><mxPoint x="470" y="190" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m2" value="2. lookup key = id + hash(secret)" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;startArrow=none;strokeColor=#3A3A3A;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="244" as="sourcePoint"/><mxPoint x="760" y="244" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m3" value="3. hit: reuse / miss: continue" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;startArrow=none;dashed=1;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="292" as="sourcePoint"/><mxPoint x="470" y="292" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m4" value="4. client_credentials at existing token endpoint" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;startArrow=none;strokeColor=#3A3A3A;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="352" as="sourcePoint"/><mxPoint x="1050" y="352" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5" value="5. short-lived token" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;startArrow=none;dashed=1;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1050" y="406" as="sourcePoint"/><mxPoint x="470" y="406" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6" value="6. store (minutes TTL)" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;startArrow=none;strokeColor=#3A3A3A;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="454" as="sourcePoint"/><mxPoint x="760" y="454" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m7" value="7. REST call + Bearer" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;startArrow=none;strokeColor=#3A3A3A;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="514" as="sourcePoint"/><mxPoint x="1340" y="514" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m8" value="8. data" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;startArrow=none;dashed=1;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="562" as="sourcePoint"/><mxPoint x="470" y="562" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m9" value="9. result (no token, no secret)" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;startArrow=none;dashed=1;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="610" as="sourcePoint"/><mxPoint x="150" y="610" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m10" value="10. 401: refresh, back to step 4" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;startArrow=none;dashed=1;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="662" as="sourcePoint"/><mxPoint x="470" y="662" as="targetPoint"/></mxGeometry></mxCell>
      </root></mxGraphModel>
  </diagram>
  <diagram id="d2" name="Scale. State is the hard part">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="720" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="banner" value="&lt;b&gt;State, not the model. Where the real engineering goes&lt;/b&gt;&lt;br&gt;The request path is stateless and scales sideways. Streaming and shared token state do not." style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#12203F;fontColor=#FFFFFF;fontSize=17;align=left;verticalAlign=middle;spacing=8;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1420" height="58" as="geometry"/></mxCell>
        <mxCell id="ai" value="&lt;b&gt;AI tools / agents&lt;/b&gt;&lt;br&gt;many concurrent&lt;br&gt;sessions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#7A3E00;fontSize=13;align=left;verticalAlign=top;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="lb" value="&lt;b&gt;Load balancer&lt;/b&gt;&lt;br&gt;+ shared edge" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#808080;fontColor=#333333;fontSize=13;align=left;verticalAlign=top;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="180" width="180" height="90" as="geometry"/></mxCell>
