        <mxCell id="n28" value="&lt;b&gt;Aggregation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;letter-spacing:0.6px&quot;&gt;INSIGHTS SQUAD&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontFamily=Inter;strokeColor=#52525b;fontColor=#52525b;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="0" y="376" width="976" height="92" as="geometry"/></mxCell>
        <mxCell id="n29" value="Directory holds the request open" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontFamily=Inter;strokeColor=none;fontColor=#52525b;fontSize=9;align=left;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="690" y="160" width="220" height="16" as="geometry"/></mxCell>
        <mxCell id="n30" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontFamily=Inter;fillColor=#52525b;strokeColor=none;opacity=50;" vertex="1" parent="1"><mxGeometry x="273" y="178" width="684" height="5" as="geometry"/></mxCell>
        <mxCell id="n31" value="&lt;b&gt;1  Names a partner&lt;/b&gt;&lt;br&gt;free text, a country,&lt;br&gt;sometimes a tax id" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;fontFamily=Inter;strokeColor=#b45309;fontColor=#b45309;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=2.4;" vertex="1" parent="1"><mxGeometry x="134" y="16" width="128" height="66" as="geometry"/></mxCell>
        <mxCell id="n32" value="&lt;b&gt;2  Ask who this is&lt;/b&gt;&lt;br&gt;resolve(candidate).&lt;br&gt;Directory blocks here.&lt;br&gt;No id in 40% of them" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;fontFamily=Inter;strokeColor=#71717a;fontColor=#71717a;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="273" y="108" width="128" height="66" as="geometry"/></mxCell>
        <mxCell id="n33" value="&lt;b&gt;3  Match, or mint&lt;/b&gt;&lt;br&gt;Under the threshold we&lt;br&gt;mint a second company&lt;br&gt;that never merges back." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;fontFamily=Inter;strokeColor=#be123c;fontColor=#be123c;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=2.4;" vertex="1" parent="1"><mxGeometry x="412" y="200" width="128" height="66" as="geometry"/></mxCell>
        <mxCell id="n34" value="&lt;b&gt;4  Link the two&lt;/b&gt;&lt;br&gt;linkOrgs(), once&lt;br&gt;identity came back" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;fontFamily=Inter;strokeColor=#71717a;fontColor=#71717a;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="551" y="108" width="128" height="66" as="geometry"/></mxCell>
        <mxCell id="n35" value="&lt;b&gt;5  Edge written&lt;/b&gt;&lt;br&gt;1 edge into 40M nodes.&lt;br&gt;Fan-out is the cost." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;fontFamily=Inter;strokeColor=#71717a;fontColor=#71717a;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="690" y="292" width="128" height="66" as="geometry"/></mxCell>
