        <mxCell id="n25" value="&lt;b&gt;Directory&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;letter-spacing:0.6px&quot;&gt;DISCOVERY SQUAD&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontFamily=Inter;strokeColor=#52525b;fontColor=#52525b;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#52525b;opacity=7;" vertex="1" parent="1"><mxGeometry x="0" y="100" width="976" height="92" as="geometry"/></mxCell>
        <mxCell id="n26" value="&lt;b&gt;Resolver&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;letter-spacing:0.6px&quot;&gt;IDENTITY SQUAD&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontFamily=Inter;strokeColor=#52525b;fontColor=#52525b;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="0" y="192" width="976" height="92" as="geometry"/></mxCell>
